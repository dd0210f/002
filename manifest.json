{
  "manifest_version": 3,
  "name": "Hedge Bot Demo",
  "version": "0.0.1",
  "description": "Variational hedge monitor demo",
  "permissions": ["storage", "tabs", "scripting", "cookies", "alarms"],
  "host_permissions": [
    "https://omni.variational.io/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hedge Monitor"
  },
  "content_scripts": [
    {
      "matches": ["https://omni.variational.io/*"],
      "js": ["content-variational.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://app.lighter.xyz/*"],
      "js": ["content-lighter.js"],
      "run_at": "document_end"
    }
  ]
}
